# The build context is everything Docker uploads before it starts. The Dockerfile
# COPYs a handful of named directories, so anything here is excluded from the
# upload rather than from the image — which is why the caches matter: .mypy_cache
# alone is tens of megabytes sent on every build, to be thrown away.
venv/
.venv/
__pycache__/
*.pyc
*.db
.git/
.gitignore
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
# Content snapshots written by the `content-export` service into a bind mount on
# the host. They are data, sometimes large, and never belong in a build.
exports/
.env
