# Database — PostgreSQL. With docker compose this is set automatically to the
# `db` service; this value is only used when running outside Docker.
DATABASE_URL=postgresql+psycopg://votations:votations@localhost:5432/votations

# Secret used to sign the anonymous voter cookie (NO personal data is stored).
# Generate a strong random value in production.
SECRET_KEY=change-me-in-production

# Provisional admin guard (HTTP Basic). Replaced by FranceConnect-based roles in V3.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Minimum number of votes before any time-bucketed breakdown is shown (anti re-identification).
MIN_BUCKET_VOLUME=50

# Cell-suppression threshold (k-anonymity) for demographic breakdowns: a breakdown
# is hidden unless every cell holds at least this many votes.
MIN_CELL_COUNT=10

# INSEE reference data (annual refresh). The estimation-population dataset is open,
# so INSEE_API_KEY is optional (only useful for rate limits).
INSEE_MELODI_BASE=https://api.insee.fr/melodi
INSEE_DATASET=DS_ESTIMATION_POPULATION
INSEE_API_KEY=
# Refresh cadence for the insee-refresh service (seconds). Default 30 days.
INSEE_REFRESH_INTERVAL=2592000

# Assemblée nationale open data — daily import of promulgated laws (Licence
# Ouverte, no key needed). The `17` in the URL is the legislature and changes
# once per legislature.
AN_DOSSIERS_URL=https://data.assemblee-nationale.fr/static/openData/repository/17/loi/dossiers_legislatifs/Dossiers_Legislatifs.json.zip
# Ignore promulgations older than this date. Leave empty to import the full backlog.
AN_IMPORT_SINCE=2026-01-01
# Import cadence for the assemblee-refresh service (seconds). Default 24 hours.
AN_REFRESH_INTERVAL=86400
