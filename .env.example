# development | production. En production, l'application refuse de démarrer sur des
# secrets d'exemple, force les cookies sécurisés et applique la limitation de débit.
# Voir DEPLOY.md.
ENVIRONMENT=development

# Cookie de votant transmis en HTTPS uniquement (à activer en production).
COOKIE_SECURE=false

# Fuseau dans lequel l'administration saisit et relit les dates d'ouverture et de
# clôture. Les instants sont stockés en UTC ; c'est ce réglage qui fait qu'« 20 h »
# dans le formulaire veut bien dire 20 h à Paris.
DISPLAY_TIMEZONE=Europe/Paris

# --- Base de données ---------------------------------------------------------

# PostgreSQL. Avec docker compose, cette valeur est fournie automatiquement par le
# service `db` ; elle ne sert qu'en exécution hors Docker.
DATABASE_URL=postgresql+psycopg://votations:votations@localhost:5432/votations

# Pool de connexions, dimensionné en regard du pool de threads qui sert les routes
# synchrones : un pool plus petit que le nombre de workers fait attendre les
# requêtes à la prise de connexion au lieu de la base.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_MAX_THREADS=24

# --- Sécurité ----------------------------------------------------------------

# Secret used to sign the anonymous voter cookie (NO personal data is stored).
# Generate a strong random value in production.
SECRET_KEY=change-me-in-production

# Provisional admin guard (HTTP Basic). Replaced by FranceConnect-based roles in V3.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Limitation de débit du vote : compteurs en mémoire, jamais journalisés.
VOTE_RATE_LIMIT=20
VOTE_RATE_WINDOW_SECONDS=300

# Tentatives de connexion administrateur échouées tolérées par adresse et par
# fenêtre. Au-delà, *toute* tentative depuis cette adresse est refusée pendant la
# fenêtre — y compris avec le bon mot de passe : c'est ce qui ralentit réellement
# une attaque par force brute, et ce qui empêche une réponse de révéler qu'un mot
# de passe était le bon. Seuls les échecs alimentent le compteur.
ADMIN_RATE_LIMIT=10
ADMIN_RATE_WINDOW_SECONDS=300

# Téléchargements de données ouvertes tolérés par adresse et par fenêtre. Bien
# plus bas que le vote : un export parcourt tous les votes d'une loi, et l'usage
# légitime se compte en quelques fichiers, pas en boucle.
EXPORT_RATE_LIMIT=10
EXPORT_RATE_WINDOW_SECONDS=300

# Nombre de proxys inverses devant l'application. L'adresse cliente est lue à cette
# distance de la *fin* de X-Forwarded-For : tout ce qui est à gauche a été écrit
# par l'appelant et se falsifie. 0 = ignorer complètement l'en-tête (pas de proxy),
# et c'est la valeur par défaut : sans proxy, faire confiance à l'en-tête revient à
# laisser l'appelant choisir sa propre clé de comptage. Derrière le Caddy fourni : 1
# (le docker-compose de production le règle déjà).
TRUSTED_PROXY_HOPS=0

# --- Anonymat ----------------------------------------------------------------

# Minimum number of votes before any time-bucketed breakdown is shown (anti re-identification).
MIN_BUCKET_VOLUME=50

# Cell-suppression threshold (k-anonymity) for demographic breakdowns: a breakdown
# is hidden unless every cell holds at least this many votes.
MIN_CELL_COUNT=10

# Résolution de l'horodatage dans l'export en accès libre : day | hour | exact.
# Publier l'instant exact de chaque vote rendrait la courbe d'évolution que
# MIN_BUCKET_VOLUME retient, et permettrait de retrouver le vote d'une personne
# dont on sait quand elle a voté. Ne passez à « exact » qu'en connaissance de cause.
EXPORT_TIME_RESOLUTION=day

# --- Mentions légales --------------------------------------------------------

# Obligatoires pour tout site français ouvert au public (LCEN, article 6-III) :
# qui édite le site, qui en dirige la publication, et qui l'héberge. Renseignés
# ici plutôt que dans un gabarit, pour qu'une mise en production ne demande pas de
# modifier du HTML. Laissés vides, la page /mentions-legales indique clairement
# qu'ils manquent — mieux vaut visiblement incomplet qu'affirmé à tort.
LEGAL_EDITOR=
LEGAL_EDITOR_ADDRESS=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_CONTACT_EMAIL=
# Nom et adresse de l'hébergeur (par exemple : « OVH SAS, 2 rue Kellermann, 59100
# Roubaix, France »).
LEGAL_HOST=

# --- Données de référence INSEE ----------------------------------------------

# INSEE reference data (annual refresh). The estimation-population dataset is open,
# so INSEE_API_KEY is optional (only useful for rate limits).
INSEE_MELODI_BASE=https://api.insee.fr/melodi
INSEE_DATASET=DS_ESTIMATION_POPULATION
INSEE_API_KEY=
# Refresh cadence for the insee-refresh service (seconds). Default 30 days.
INSEE_REFRESH_INTERVAL=2592000

# --- Import des lois promulguées ---------------------------------------------

# Assemblée nationale open data — daily import of promulgated laws (Licence
# Ouverte, no key needed). The `17` in the URL is the legislature and changes
# once per legislature.
AN_DOSSIERS_URL=https://data.assemblee-nationale.fr/static/openData/repository/17/loi/dossiers_legislatifs/Dossiers_Legislatifs.json.zip
# Fenêtre glissante : n'importer que les promulgations des N derniers jours, pour
# que l'import n'accumule pas un arriéré grandissant au fil des années. Mettre 0
# pour tout importer.
AN_IMPORT_SINCE_DAYS=365
# Date absolue facultative ; si renseignée, elle l'emporte sur la fenêtre glissante.
AN_IMPORT_SINCE=
# Au-delà de ce délai sans import réussi, l'administration affiche une alerte.
AN_IMPORT_STALE_AFTER_HOURS=48
# Import cadence for the assemblee-refresh service (seconds). Default 24 hours.
AN_REFRESH_INTERVAL=86400

# Journal Officiel (DILA) — archives quotidiennes utilisées pour récupérer le
# texte officiel d'une loi promulguée. Licence Ouverte, sans authentification.
JORF_DUMPS_URL=https://echanges.dila.gouv.fr/OPENDATA/JORFSIMPLE/

# --- Brouillons IA (facultatif) ----------------------------------------------

# Sans clé, le bouton « Brouillon IA » n'apparaît pas dans l'administration.
# Aucun brouillon n'est jamais généré automatiquement.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Les jetons de raisonnement sont facturés en sortie : medium suffit pour résumer
# et citer, et divise à peu près par deux le coût d'un brouillon.
AI_EFFORT=medium
# Interventions envoyées au modèle pour la sélection des arguments.
AI_MAX_SPEECHES=40
# Arguments proposés par camp. C'est un vivier à trier, pas ce qui sera publié :
# les citations coûtent quelques centimes, mais cinq arguments par camp font
# beaucoup à lire sur la page publique.
AI_ARGUMENTS_PER_SIDE=5
AI_RESERVES_MAX=3
# Refus au-delà de cette taille, pour ne pas dépenser sur un texte hors norme.
AI_MAX_INPUT_TOKENS=150000
# Délai global d'un brouillon (téléchargements JO + appels modèle). Au-delà, le
# travail de fond abandonne avec un message plutôt que de rester suspendu.
AI_DRAFT_DEADLINE_SECONDS=600
# Fils d'exécution réservés aux brouillons. Ils tournent sur leur propre petit pool
# et non sur celui qui sert les requêtes : un brouillon occupe son fil pendant des
# minutes, et emprunter la capacité du site pendant ce temps le fait patienter.
DRAFT_WORKERS=2
