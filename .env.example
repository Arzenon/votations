# Configuration de Votations Françaises.
#
#   cp .env.example .env    puis remplissez ce qui suit.
#
# Seuls les réglages à décider figurent ici. Les autres ont une valeur par
# défaut, documentée dans `app/config.py`, et peuvent aussi être surchargés ici.
#
# En production, l'application refuse de démarrer avec les valeurs d'exemple.

# --- Environnement et secrets ------------------------------------------------

SITE_DOMAIN=votations.fr
POSTGRES_PASSWORD=

# Signe le cookie de votant. Avec la valeur d'exemple, n'importe qui pourrait
# forger des jetons et voter sans limite.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Anciennes clés, séparées par des virgules, la plus ancienne d'abord. À utiliser
# quand on change SECRET_KEY (migration vers une autre machine, rotation) :
# sinon chaque votant reçoit un nouveau jeton et peut revoter. À retirer au bout
# d'un an. Jamais une clé compromise. Voir DEPLOY.md, « Changer de clé ».
# SECRET_KEY_FALLBACKS=

# Accès provisoire à l'administration (HTTP Basic). ASCII uniquement : un mot
# de passe accentué ne pourrait jamais correspondre.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Anonymat : ce que la plateforme accepte de publier -----------------------

# En dessous de ce nombre de votes, la courbe d'évolution n'est pas affichée et
# l'export ne porte aucun horodatage.
MIN_BUCKET_VOLUME=50

# Une répartition par profil n'est affichée que si chaque case atteint ce seuil.
MIN_CELL_COUNT=10

# Précision de l'horodatage dans l'export : day, hour ou exact. Avec exact, on
# peut retrouver le vote d'une personne dont on sait quand elle a voté.
EXPORT_TIME_RESOLUTION=day

# --- Mentions légales --------------------------------------------------------

# Adresse de contact, affichée sur /mentions-legales, /vie-privee et les pages de
# loi (« Signaler une erreur »). Facultative. Préférez un alias : elle sera
# collectée par les robots.
LEGAL_CONTACT_EMAIL=

# Nom et adresse de l'hébergeur, obligatoires (LCEN, article 6-III). Tant que
# c'est vide, /mentions-legales indique que la page est incomplète. Exemple :
#   OVH SAS, 2 rue Kellermann, 59100 Roubaix, France
LEGAL_HOST=

# --- Brouillons IA (facultatif) ----------------------------------------------

# Sans clé, le bouton « Brouillon IA » n'apparaît pas. Les brouillons sont
# toujours relus avant publication.
ANTHROPIC_API_KEY=
