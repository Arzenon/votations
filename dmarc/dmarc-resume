#!/usr/bin/env python3
"""Résumé lisible des rapports agrégés DMARC.

    dmarc-resume rapport.xml
    dmarc-resume ~/Bureau/*.xml *.xml.gz *.zip

Accepte les rapports tels qu'ils arrivent : .xml, .xml.gz, ou .zip contenant un
XML (les trois formes que les opérateurs utilisent). Agrège tous les fichiers
passés en argument, puis sépare ce qui va de ce qui ne va pas.

Code de sortie 1 si au moins un message a échoué à DMARC : de quoi brancher la
commande dans une tâche planifiée qui ne parle que lorsqu'il y a un problème.
"""

from __future__ import annotations

import argparse
import gzip
import socket
import sys
import zipfile
from collections import defaultdict
from datetime import datetime, timezone
from pathlib import Path
from xml.etree import ElementTree

# ElementTree n'expanse pas les entités externes, mais reste sensible aux bombes
# de décompression d'entités. Un rapport DMARC réel dépasse rarement quelques
# centaines de kilo-octets ; ce plafond écarte le fichier hostile sans jamais
# gêner un fichier légitime. Il porte sur la taille *décompressée*, parce que
# c'est celle qui compte pour un .gz de trois octets qui en produit un milliard.
TAILLE_MAX = 20 * 1024 * 1024


def lire(chemin: Path) -> bytes:
    """Le XML d'un rapport, quelle que soit son enveloppe."""
    if chemin.suffix == ".gz":
        with gzip.open(chemin, "rb") as f:
            donnees = f.read(TAILLE_MAX + 1)
    elif chemin.suffix == ".zip":
        with zipfile.ZipFile(chemin) as z:
            noms = [n for n in z.namelist() if n.endswith(".xml")]
            if not noms:
                raise ValueError("archive sans fichier .xml")
            with z.open(noms[0]) as f:
                donnees = f.read(TAILLE_MAX + 1)
    else:
        donnees = chemin.read_bytes()

    if len(donnees) > TAILLE_MAX:
        raise ValueError(f"fichier anormalement gros (> {TAILLE_MAX // 1024 // 1024} Mo)")
    return donnees


def texte(noeud, chemin: str, defaut: str = "?") -> str:
    trouve = noeud.find(chemin)
    return trouve.text.strip() if trouve is not None and trouve.text else defaut


def horodatage(brut: str) -> datetime | None:
    try:
        return datetime.fromtimestamp(int(brut), tz=timezone.utc)
    except (ValueError, TypeError, OSError):
        return None


def nom_inverse(ip: str) -> str:
    try:
        return socket.gethostbyaddr(ip)[0]
    except (OSError, socket.herror):
        return ""


def main() -> int:
    ap = argparse.ArgumentParser(description="Résumé lisible de rapports agrégés DMARC.")
    ap.add_argument("fichiers", nargs="+", type=Path)
    ap.add_argument(
        "--dns",
        action="store_true",
        help="résoudre le nom des IP émettrices (fait des requêtes réseau)",
    )
    args = ap.parse_args()

    # (ip, from, dkim aligné, spf aligné, disposition) -> nombre de messages
    lignes: dict[tuple, int] = defaultdict(int)
    declarants: set[str] = set()
    debut: datetime | None = None
    fin: datetime | None = None
    total = 0
    illisibles: list[str] = []

    for chemin in args.fichiers:
        try:
            racine = ElementTree.fromstring(lire(chemin))
        except (OSError, ValueError, zipfile.BadZipFile, ElementTree.ParseError) as e:
            illisibles.append(f"{chemin.name} : {e}")
            continue

        declarants.add(texte(racine, "report_metadata/org_name"))
        d = horodatage(texte(racine, "report_metadata/date_range/begin", ""))
        f = horodatage(texte(racine, "report_metadata/date_range/end", ""))
        if d and (debut is None or d < debut):
            debut = d
        if f and (fin is None or f > fin):
            fin = f

        for record in racine.findall("record"):
            nombre = int(texte(record, "row/count", "0") or 0)
            total += nombre
            cle = (
                texte(record, "row/source_ip"),
                texte(record, "identifiers/header_from"),
                texte(record, "row/policy_evaluated/dkim", "fail"),
                texte(record, "row/policy_evaluated/spf", "fail"),
                texte(record, "row/policy_evaluated/disposition", "none"),
            )
            lignes[cle] += nombre

    if illisibles:
        print("Fichiers ignorés :", file=sys.stderr)
        for ligne in illisibles:
            print(f"  {ligne}", file=sys.stderr)
        print(file=sys.stderr)

    if not lignes:
        print("Aucun enregistrement exploitable.")
        return 2

    # DMARC passe dès qu'*un* des deux mécanismes est aligné.
    conformes = {c: n for c, n in lignes.items() if c[2] == "pass" or c[3] == "pass"}
    echecs = {c: n for c, n in lignes.items() if c not in conformes}

    periode = "période inconnue"
    if debut and fin:
        if debut.date() == fin.date():
            periode = f"le {debut:%d/%m/%Y}"
        else:
            periode = f"du {debut:%d/%m/%Y} au {fin:%d/%m/%Y}"

    print(f"Rapports DMARC — {periode}")
    print(f"{len(args.fichiers) - len(illisibles)} rapport(s) de : {', '.join(sorted(declarants))}")
    print(f"{total} message(s) au total\n")

    def tableau(titre: str, groupe: dict[tuple, int]) -> None:
        if not groupe:
            return
        print(titre)
        for (ip, expediteur, dkim, spf, disposition), nombre in sorted(
            groupe.items(), key=lambda kv: -kv[1]
        ):
            nom = f" ({nom_inverse(ip)})" if args.dns and nom_inverse(ip) else ""
            print(f"  {nombre:>6} msg  {ip}{nom}")
            print(f"          from: {expediteur}   dkim: {dkim}   spf: {spf}   traitement: {disposition}")
        print()

    tableau(f"✅ Conformes — {sum(conformes.values())} message(s)", conformes)
    tableau(f"⚠️  ÉCHEC DMARC — {sum(echecs.values())} message(s)", echecs)

    if echecs:
        print("Pour chaque ligne en échec : soit c'est un de vos outils dont SPF/DKIM")
        print("n'est pas configuré, soit quelqu'un usurpe votre domaine. Identifiez")
        print("l'IP avant de durcir la politique.")
        return 1

    print("Rien à signaler : tous les messages étaient authentifiés et alignés.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
