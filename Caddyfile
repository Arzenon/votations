# Terminates TLS and forwards to the app. Caddy obtains and renews the
# certificate on its own; the domain must already resolve to this host.

{
	servers {
		timeouts {
			# `write` matters for exports, which hold a DB connection while the
			# client reads: slow clients could hold them indefinitely. 30 minutes
			# leaves room for a large export on a slow connection.
			read_body 1m
			read_header 10s
			write 30m
			idle 2m
		}
	}
}

# Headers and log settings shared by every hostname, including www.
(commun) {
	header {
		# The site embeds nothing and is embedded nowhere.
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# Everything is served from this origin, no inline scripts or styles.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"

		# No camera, microphone, geolocation or interest-cohort involvement.
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"

		# Caddy adds this header by default.
		-Server
	}

	# Errors only, and without the IP address: a 5xx on a vote would otherwise
	# log an IP next to the time of a vote. Cookies are removed too (the voter
	# token must never be logged).
	log {
		output stderr
		level ERROR
		format filter {
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>headers>X-Forwarded-For delete
				request>headers>Cookie delete
			}
		}
	}
}

{$SITE_DOMAIN} {
	import commun

	encode zstd gzip

	# Forms post a few kB at most (the admin form fits in 256 kB).
	request_body {
		max_size 256KB
	}

	# The health check is only for Docker (run inside the container).
	respond /sante 404

	# The app is only reachable through here.
	reverse_proxy app:8000 {
		# Replace (not append) X-Forwarded-For, used by the rate limit. Caddy
		# already does this without trusted_proxies (hence a warning at start),
		# but we don't rely on that default. X-Real-IP isn't used by the app.
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
}

www.{$SITE_DOMAIN} {
	import commun
	redir https://{$SITE_DOMAIN}{uri} permanent
}
